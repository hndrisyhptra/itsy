APP_NAME="its Area 3 Prototype"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8013
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Untuk migration skema MySQL Area 3, gunakan DB_CONNECTION=mysql dan isi:
# DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=its
# DB_USERNAME=isi_pengguna_database_Anda
# DB_PASSWORD=isi_password_database_Anda
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_COOKIE=its_area3_prototype_session
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
