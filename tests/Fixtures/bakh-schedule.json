        "end": "2026-11-30"
      },
      {
        "days": 4,
        "start": "2026-12-01",
        "end": "2026-12-04"
      },
      {
        "days": 7,
        "start": "2026-12-05",
        "end": "2026-12-11"
      },
      {
        "days": 1,
        "start": "2026-12-12",
