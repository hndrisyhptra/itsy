      }
    ],
    "expected": {
      "start": "2026-11-01",
      "end": "2026-11-05",
      "hk": 5
    }
  },
  {
    "name": "zero stages and leap day",
    "schedule": [
      {
        "days": 0,
        "start": "",
        "end": ""
      },
      {
        "days": 3,
        "start": "2028-02-28",
        "end": "2028-03-01"
      }
    ],
    "expected": {
      "start": "2028-02-28",
      "end": "2028-03-01",
      "hk": 3
    }
  },
  {
